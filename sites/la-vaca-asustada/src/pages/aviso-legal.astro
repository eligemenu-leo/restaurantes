---
import '../styles/theme.css';
import LegalPage from '@rea/core/components/LegalPage.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/index.ts';
import html from '../content/legal/aviso-legal.html?raw';
---
<LegalPage site={site} title="Aviso legal" path="/aviso-legal/" html={html}>
  <SiteHeader slot="header" current="/aviso-legal/" />
  <SiteFooter slot="footer" />
</LegalPage>
