---
import '../styles/theme.css';
import LegalPage from '@rea/core/components/LegalPage.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/index.ts';
import html from '../content/legal/politica-de-privacidad.html?raw';
---
<LegalPage site={site} title="Política de privacidad" path="/politica-de-privacidad/" html={html}>
  <SiteHeader slot="header" current="/politica-de-privacidad/" />
  <SiteFooter slot="footer" />
</LegalPage>
