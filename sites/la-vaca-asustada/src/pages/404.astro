---
import Layout from '../components/Layout.astro';
---
<Layout title="Página no encontrada" path="/404/" noindex>
  <div class="wrap section nf">
    <h1>Esta página no existe</h1>
    <p>Puede que la dirección haya cambiado con la nueva web.</p>
    <div class="btn-row"><a class="btn" href="/menu/">Ver el menú</a><a class="btn" href="/">Ir al inicio</a></div>
  </div>
</Layout>
<style>.nf { text-align: center; } .nf .btn-row { justify-content: center; margin-top: 2rem; }</style>
