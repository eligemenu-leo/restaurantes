---
// Sobre nosotros, como en la original: tres bandas a dos columnas (foto y texto), alternando el lado.
import Layout from '../components/Layout.astro';
import Photo from '@rea/core/components/Photo.astro';
import historia from '../assets/web/Pizarra-Vaca-Asustada-4.jpg';
import equipo from '../assets/web/6.jpg';
import filosofia from '../assets/web/CU5A9723-scaled.jpg';

const bands = [
  {
    img: historia, alt: 'Detalle del comedor de La Vaca Asustada', label: 'sobre nosotros', title: 'Nuestra historia', h1: true,
    html: 'Luis y Rocío, apasionados por la gastronomía, soñaban con crear un restaurante donde la carne de vaca fuera la protagonista. Originarios de Amarante, Portugal, y con una trayectoria en el mundo de la hostelería en Asturias, decidieron llevar su pasión al siguiente nivel en <strong>La Vaca Asustada</strong>. <strong>Con la experiencia de Luis en lugares como La Teyera y El Guarapu, y el conocimiento empresarial de Rocío</strong>, crearon un espacio donde se rinde homenaje a las mejores carnes del mundo, fusionando tradición y modernidad en cada plato.',
  },
  {
    img: equipo, alt: 'Personal de La Vaca Asustada', label: 'inovación y tradición', title: 'Nuestro equipo', flip: true,
    html: 'Con un profundo respeto por las <strong>técnicas tradicionales y un enfoque innovador</strong>, nuestro equipo garantiza que cada plato sea una experiencia excepcional. Cada miembro de nuestro equipo comparte el compromiso de ofrecerte la perfección en cada bocado.',
  },
  {
    img: filosofia, alt: 'Corte de carne madurada en la cocina', label: '20 años de experiencia', title: 'Nuestra filosofía',
    html: '<strong>En Vaca Asustada</strong>, redefinimos el arte de la carne madurada. Nuestra dedicación a la calidad y la perfección se refleja en cada detalle. Utilizamos técnicas tradicionales combinadas con innovación para ofrecer una experiencia gastronómica única. Sostenibilidad y elegancia son nuestros pilares, garantizando que cada visita sea memorable.',
  },
];
---
<Layout title="Sobre nosotros" path="/sobre-nosotros/"
  description="Luis y Rocío crearon La Vaca Asustada para rendir homenaje a las mejores carnes del mundo, fusionando tradición y modernidad. Gijón y Oviedo.">
  {bands.map((b, i) => {
    const H = b.h1 ? 'h1' : 'h2';
    return (
      <section class:list={['band', { 'band--flip': b.flip }]} aria-labelledby={`b${i}`}>
        <Photo src={b.img} alt={b.alt} sizes="(min-width: 48rem) 50vw, 100vw" widths={[480, 720, 960, 1280]} loading={i === 0 ? 'eager' : 'lazy'} class="band__img" />
        <div class="band__txt">
          <p class="eyebrow">{b.label}</p>
          <H id={`b${i}`}>{b.title}</H>
          <p set:html={b.html} />
        </div>
      </section>
    );
  })}
</Layout>
<style>
  .band { display: grid; background: var(--c-bg); }
  .band:nth-of-type(2n) { background: var(--c-surface); }
  @media (min-width: 48rem) {
    .band { grid-template-columns: 1fr 1fr; min-height: 36rem; }
    .band--flip .band__txt { order: -1; }
  }
  :global(.band__img) { width: 100%; height: 100%; max-height: 52rem; object-fit: cover; }
  @media (max-width: 47.99rem) { :global(.band__img) { aspect-ratio: 4 / 3; height: auto; } }
  .band__txt { align-self: center; padding: clamp(3rem, 8vw, 6.25rem) clamp(1.25rem, 6vw, 5rem); max-width: 40rem; }
  .band--flip .band__txt { justify-self: end; }
  .band h1, .band h2 { font: 400 clamp(2.2rem, 4.5vw, 2.875rem)/1.05 var(--f-display); color: #fff; margin-bottom: 1.5rem; }
  .band p:last-child { margin: 0; font-size: 1rem; }
  .band :global(strong) { color: #fff; font-weight: 500; }
</style>
