---
import { Image } from 'astro:assets';
// Cabecera de la web original (tema UiCore): barra superior con las dos direcciones,
// teléfono y email; debajo, barra fija con el logo dorado a la izquierda y el menú a la derecha.
// Es transparente sobre la primera imagen y se oscurece al bajar.
import { telHref } from '@rea/core/lib/format.ts';
import { site } from '../data/index.ts';
import logo from '../assets/web/Recurso-4.png';
interface Props { current: string; overlay?: boolean }
const { current, overlay = false } = Astro.props;
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href) || (href === '/menu/' && current.startsWith('/menu')));
const [gijon, oviedo] = ['gijon', 'oviedo'].map((id) => site.locations.find((l) => l.id === id)!);
const addr = (l: typeof gijon) => `${l.address.street.replace(/ bajo$/i, ' Bajo')} - ${l.address.postalCode} ${l.address.locality} (Asturias)`;
const pin = 'M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z';
---
<div class="tb">
  <div class="tb__in">
    <p>
      <span><svg aria-hidden="true" viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d={pin}/></svg> {addr(gijon)}</span>
      <span class="tb__sep" aria-hidden="true">|</span>
      <span><svg aria-hidden="true" viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d={pin}/></svg> {addr(oviedo)}</span>
    </p>
    <p>
      <a href={telHref(gijon.phone)}><svg aria-hidden="true" viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z"/></svg> {gijon.phone}</a>
      <a href={`mailto:${gijon.email}`}><svg aria-hidden="true" viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 7.2L4.4 7H4v.6l8 5.4 8-5.4V7h-.4L12 12.2Z"/></svg> {gijon.email}</a>
    </p>
  </div>
</div>
<header class:list={['sh', { 'sh--overlay': overlay }]}>
  <div class="sh__in">
    <a class="sh__brand" href="/">
      <Image src={logo} alt={site.name} />
    </a>
    <details class="sh__menu">
      <summary><span class="sh__burger" aria-hidden="true"></span><span class="visually-hidden">Menú</span></summary>
      <nav aria-label="Principal">
        <ul>
          {site.nav.map((n) => (
            <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
<style>
  .tb { background: var(--c-bg); color: #fff; font: 400 0.75rem/1 var(--f-body); display: none; }
  .tb__in { width: min(100% - 2 * var(--space), var(--w-max)); margin-inline: auto; display: flex; justify-content: space-between; gap: 1rem; padding-block: 19px; }
  .tb p { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .tb span, .tb a { display: inline-flex; align-items: center; gap: 0.45rem; text-decoration: none; }
  .tb a + a { margin-left: 1.6rem; }
  .tb svg { color: var(--c-accent); }
  @media (min-width: 64rem) { .tb { display: block; } }

  /* Barra fija. En portada se superpone al vídeo (margen negativo) y es transparente al principio. */
  .sh { position: sticky; top: 0; z-index: 50; background: var(--c-bg); }
  .sh--overlay { margin-bottom: calc(-1 * var(--sh-h)); background: transparent; }
  @supports (animation-timeline: scroll()) {
    .sh--overlay { animation: sh-solid linear both; animation-timeline: scroll(root); animation-range: 0 12rem; }
    @keyframes sh-solid { to { background: rgb(14 13 12 / 0.96); box-shadow: 0 1px 0 var(--c-line); } }
  }
  @supports not (animation-timeline: scroll()) {
    .sh--overlay { background: linear-gradient(rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.25)); }
  }
  /* Original: barra de 160 px de alto, logo de 100 px con 30 px arriba y abajo. */
  :root { --sh-h: 10rem; }
  .sh__in { width: min(100% - 2 * var(--space), var(--w-max)); margin-inline: auto; height: var(--sh-h); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .sh__brand { display: flex; align-items: center; padding-right: 20px; }
  .sh__brand img { height: 100px; width: auto; }
  .sh__menu summary { list-style: none; cursor: pointer; display: grid; place-items: center; width: 48px; height: 48px; }
  .sh__menu summary::-webkit-details-marker { display: none; }
  .sh__burger, .sh__burger::before, .sh__burger::after { display: block; width: 24px; height: 2px; background: #fff; position: relative; }
  .sh__burger::before, .sh__burger::after { content: ''; position: absolute; left: 0; }
  .sh__burger::before { top: -7px; } .sh__burger::after { top: 7px; }
  .sh__menu ul { list-style: none; margin: 0; padding: 0; }
  .sh__menu a {
    display: block; padding: 0.9rem 0; text-decoration: none; color: #fff;
    font: 400 0.75rem/1.2 var(--f-body); letter-spacing: 3.6px; text-transform: uppercase;
  }
  .sh__menu a[aria-current='page'], .sh__menu a:hover { color: var(--c-accent); }
  .sh__menu nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--c-bg); border-bottom: 1px solid var(--c-line); padding: 0.5rem var(--space) 1rem; }
  @media (max-width: 63.99rem) { :root { --sh-h: 5.5rem; } .sh__brand img { height: 4rem; } }
  @media (min-width: 64rem) {
    .sh__menu summary { display: none; }
    .sh__menu nav { position: static; padding: 0; border: 0; background: none; }
    .sh__menu ul { display: flex; gap: 0; }
    .sh__menu li a { padding-inline: 25px; line-height: 160px; }
    .sh__menu li:last-child a { padding-right: 0; }
    .sh__menu a { padding-block: 0; }
  }
</style>
<script is:inline>
  // En escritorio el menú está siempre abierto; en móvil se pliega. Sin JS sigue siendo un desplegable.
  (function () {
    var d = document.querySelector('.sh__menu');
    var mq = matchMedia('(min-width: 64rem)');
    function sync() { if (d) d.open = mq.matches; }
    sync(); mq.addEventListener('change', sync);
  })();
</script>
