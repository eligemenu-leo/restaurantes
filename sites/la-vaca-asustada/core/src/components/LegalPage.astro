---
// Página legal. Mientras no se migre el texto original, se publica con noindex y un aviso visible.
import type { SiteData } from '../lib/schema.ts';
import BaseLayout from './BaseLayout.astro';
import type { ImageMetadata } from 'astro';
interface Props { site: SiteData; title: string; path: string; pending?: boolean; logo?: ImageMetadata; html?: string; index?: boolean }
const { site, title, path, pending = false, logo, html, index = false } = Astro.props;
---
<BaseLayout site={site} title={title} path={path} noindex={!index} logo={logo}>
  {Astro.slots.has('header') && <slot name="header" slot="header" />}
  {Astro.slots.has('footer') && <slot name="footer" slot="footer" />}
  <article class="wrap section legal">
    <h1>{title}</h1>
    {pending ? <p class="legal__pending">Texto pendiente de migrar desde la web anterior.</p> : html ? <div class="legal__body" set:html={html} /> : <slot />}
  </article>
</BaseLayout>
<style>
  .legal { max-width: var(--w-text); }
  .legal h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .legal__body :global(h2) { font-size: 1.4rem; margin-top: 2rem; }
  .legal__body :global(li) { margin-bottom: 0.4rem; }
  .legal__pending { padding: 1rem 1.25rem; border: 2px dashed var(--c-accent); }
</style>
