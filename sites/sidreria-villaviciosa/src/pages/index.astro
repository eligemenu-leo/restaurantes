---
import '../styles/theme.css';
import BaseLayout from '@rea/core/components/BaseLayout.astro';
import LocationCard from '@rea/core/components/LocationCard.astro';
import Reviews from '@rea/core/components/Reviews.astro';
import Photo from '@rea/core/components/Photo.astro';
import { restaurantGraph } from '@rea/core/lib/jsonld.ts';
import { price, telHref } from '@rea/core/lib/format.ts';
import { site, sugerencias, destacados, local } from '../data/index.ts';
import fachada from '../assets/fachada.jpg';
import escanciado from '../assets/escanciado.jpg';
import ambiente from '../assets/ambiente.jpg';
import tomates from '../assets/tomates.jpg';
import fabada from '../assets/fabada.jpg';
import pixin from '../assets/pixin.jpg';
import cachopo from '../assets/cachopo.jpg';
import arroz from '../assets/arroz-con-leche.jpg';

// Foto de cada plato destacado, en el mismo orden que `destacados`.
const fotos = [tomates, fabada, pixin, cachopo, arroz];
const platos = destacados.map((d, n) => ({ ...d, foto: fotos[n] })).filter((d) => d.item);
---
<BaseLayout
  site={site}
  title="Sidrería Villaviciosa · Cocina asturiana y sidra en la calle Gascona, Oviedo"
  path="/"
  jsonLd={[restaurantGraph(site, `${site.url}/nuestra-carta/`)]}
>
  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__txt">
        <p class="eyebrow">Calle Gascona, 7 · Oviedo</p>
        <h1>Tu sidrería en pleno corazón de Gascona</h1>
        <p class="lead">Un lugar para celebrar, picar algo rico y sentir el espíritu de la sidra asturiana.</p>
        <div class="btn-row">
          <a class="btn" href={telHref(local.phone)}>Reservar · {local.phone}</a>
          <a class="btn btn--ghost" href="/nuestra-carta/">Ver nuestra carta</a>
        </div>
      </div>
      <Photo src={fachada} alt="Fachada iluminada de Sidrería Villaviciosa en la calle Gascona" loading="eager"
        sizes="(min-width: 60rem) 55vw, 100vw" class="hero__img" />
    </div>
  </section>

  {sugerencias && <section class="section sug" id="sugerencias" aria-labelledby="sug-h">
    <div class="wrap sug__in">
      <div>
        <p class="eyebrow">Recomendación del chef</p>
        <h2 id="sug-h">Sugerencias para hoy</h2>
        <p>Platos fuera de carta que cambian según mercado. Pregunta en sala por los de hoy.</p>
      </div>
      <ul class="sug__list">
        {sugerencias.items.map((i) => (
          <li><span>{i.name}</span>{i.price != null && <span class="sug__p">{price(i.price, i.unit)}</span>}</li>
        ))}
      </ul>
    </div>
  </section>}

  <section class="section dest" aria-labelledby="dest-h">
    <div class="wrap">
      <p class="eyebrow">De la carta</p>
      <h2 id="dest-h">Los imprescindibles de la casa</h2>
      <ol class="dest__list">
        {platos.map((d) => (
          <li>
            <Photo src={d.foto} alt={d.item!.name} sizes="(min-width: 60rem) 20vw, (min-width: 40rem) 45vw, 90vw" widths={[320, 480, 640, 960]} class="dest__img" />
            <p class="dest__t">{d.tagline}</p>
            <h3>{d.item!.name}</h3>
            {d.item!.price != null && <p class="dest__p">{price(d.item!.price, d.item!.unit)}</p>}
          </li>
        ))}
      </ol>
      <a class="btn btn--ghost" href="/nuestra-carta/">Ver carta completa</a>
    </div>
  </section>

  <section class="section casa" aria-labelledby="casa-h">
    <div class="wrap casa__in">
      <div class="casa__fotos">
        <Photo src={escanciado} alt="Camarero escanciando sidra en la sala" sizes="(min-width: 52rem) 25vw, 50vw" widths={[320, 480, 640, 1000]} />
        <Photo src={ambiente} alt="Sala de la sidrería llena de clientes" sizes="(min-width: 52rem) 25vw, 50vw" widths={[320, 480, 640, 800]} />
      </div>
      <div>
        <p class="eyebrow">Bienvenido</p>
        <h2 id="casa-h">Bienvenido a la Sidrería Villaviciosa</h2>
        <p class="casa__lead">Cocina casera, auténtica y hecha con cariño, como siempre se ha comido en casa.</p>
        <p>En plena calle Gascona, la sidra es más que una bebida: es cultura, encuentro y celebración. Aquí se escancia con orgullo.</p>
        <a href="/quienes-somos/">Conoce nuestra historia</a>
      </div>
    </div>
  </section>

  <Reviews reviews={site.reviews} />

  <section class="section" id="reservas" aria-labelledby="res-h">
    <div class="wrap res">
      <div>
        <p class="eyebrow">Reservas</p>
        <h2 id="res-h">Reserva tu mesa</h2>
        <p class="lead">Asegúrate de poder disfrutar de un momento único. Tú eliges la compañía. Reservas por teléfono en el <a href={telHref(local.phone)}>{local.phone}</a>.</p>
      </div>
      <LocationCard location={local} title="Horario y ubicación" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(2.5rem, 7vw, 5rem); }
  .hero__in { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 60rem) { .hero__in { grid-template-columns: 0.9fr 1.1fr; gap: 4rem; } }
  .hero h1 { max-width: 13ch; }
  .hero .lead { margin-bottom: 2rem; }
  :global(.hero__img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .sug { background: var(--c-accent); color: var(--c-accent-text); }
  .sug .eyebrow { color: inherit; opacity: 0.8; }
  .sug__in { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 52rem) { .sug__in { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .sug__list { list-style: none; margin: 0; padding: 0; font: 500 1.4rem/1.3 var(--f-display); }
  .sug__list li { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid color-mix(in srgb, currentColor 30%, transparent); }
  .sug__p { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .dest__list { list-style: none; margin: 2.5rem 0; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .dest__list li { display: flex; flex-direction: column; }
  :global(.dest__img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; margin-bottom: 1rem; }
  .dest__t { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--c-muted); margin: 0 0 0.4rem; }
  .dest__list h3 { flex: 1; font-size: 1.2rem; }
  .dest__p { margin: 0; font-weight: 600; }
  .casa { background: var(--c-surface); border-block: 1px solid var(--c-line); }
  .casa__in { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 52rem) { .casa__in { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .casa__fotos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .casa__fotos :global(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .casa__fotos > :global(picture:nth-child(2)) { margin-top: 3rem; }
  .casa__lead { font: 500 1.4rem/1.4 var(--f-display); }
  .res { display: grid; gap: 2rem; }
  @media (min-width: 60rem) { .res { grid-template-columns: 1fr 1.1fr; gap: 4rem; align-items: start; } }
</style>
