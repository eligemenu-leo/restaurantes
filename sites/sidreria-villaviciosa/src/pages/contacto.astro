---
import '../styles/theme.css';
import BaseLayout from '@rea/core/components/BaseLayout.astro';
import LocationCard from '@rea/core/components/LocationCard.astro';
import { restaurantGraph } from '@rea/core/lib/jsonld.ts';
import { telHref } from '@rea/core/lib/format.ts';
import { site, local } from '../data/index.ts';
---
<BaseLayout site={site} title="Reservas y contacto" path="/contacto/"
  description="Reserva en Sidrería Villaviciosa: llama al 984 68 14 15 o escribe a hola@sidreriavillaviciosa.es. Calle Gascona, 7, Oviedo."
  jsonLd={[restaurantGraph(site)]}>
  <div class="wrap section ct">
    <div id="reservas">
      <p class="eyebrow">Reservas</p>
      <h1>Reserva tu mesa</h1>
      <p class="lead">La forma más rápida es llamar. Si prefieres, escríbenos con el día, la hora y el número de personas y te confirmamos.</p>
      <div class="btn-row">
        <a class="btn" href={telHref(local.phone)}>Llamar al {local.phone}</a>
        <a class="btn btn--ghost" href={`mailto:${local.email}?subject=${encodeURIComponent('Reserva')}`}>Escribir un correo</a>
      </div>
    </div>
    <LocationCard location={local} title="Dónde estamos" headingLevel={2} />
  </div>
</BaseLayout>
<style>
  .ct { display: grid; gap: 3rem; }
  @media (min-width: 60rem) { .ct { grid-template-columns: 1fr 1.1fr; align-items: start; gap: 4rem; } }
  .ct .lead { margin-bottom: 2rem; }
</style>
