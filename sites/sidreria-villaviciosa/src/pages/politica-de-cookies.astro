---
import '../styles/theme.css';
import LegalPage from '@rea/core/components/LegalPage.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/index.ts';
---
<LegalPage site={site} title="Política de cookies" path="/politica-de-cookies/">
  <SiteHeader slot="header" current="/politica-de-cookies/" />
  <SiteFooter slot="footer" />

  <p>Esta web no instala cookies propias ni de terceros y no utiliza herramientas de analítica ni publicidad. Por eso no te pedimos consentimiento al entrar.</p>
  
  <p>Si en el futuro incorporamos cookies que requieran tu consentimiento, actualizaremos esta página y te lo pediremos antes de instalarlas.</p>
</LegalPage>
