---
// Plantilla de la web: la del núcleo con la cabecera y el pie propios de la Sidrería.
import '../styles/theme.css';
import BaseLayout from '@rea/core/components/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { site } from '../data/index.ts';
type BaseProps = Omit<Parameters<typeof BaseLayout>[0], 'site'>;
interface Props extends BaseProps { overlayHeader?: boolean; /** Idioma de la página, si no es el de la web (cartas traducidas). */ lang?: string }
const { overlayHeader = false, lang = site.lang, ...rest } = Astro.props;
---
<BaseLayout site={{ ...site, lang }} {...rest}>
  <Fragment slot="head"><slot name="head" /></Fragment>
  <SiteHeader slot="header" current={rest.path} overlay={overlayHeader} />
  <slot />
  <SiteFooter slot="footer" />
</BaseLayout>
