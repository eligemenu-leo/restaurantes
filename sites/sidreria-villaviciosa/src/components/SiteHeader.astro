---
// Cabecera de la web original: barra superior con dirección, teléfono y email;
// debajo, logo, menú centrado en mayúsculas y botón "Reservar mesa".
// En la portada va superpuesta a la imagen (overlay).
import { telHref } from '@rea/core/lib/format.ts';
import { site, local } from '../data/index.ts';
interface Props { current: string; overlay?: boolean }
const { current, overlay = false } = Astro.props;
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
const a = local.address;
---
<header class:list={['sh', { 'sh--overlay': overlay }]}>
  <div class="sh__top">
    <div class="sh__wide sh__top-in">
      <p class="sh__info">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
        {a.street.replace(/^C\/\s*/, '')}, {a.locality}, {a.region}, {a.postalCode}
      </p>
      <p class="sh__info sh__contact">
        <a href={telHref(local.phone)}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z"/></svg>
          +34 {local.phone}
        </a>
        {local.email && <a href={`mailto:${local.email}`}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 7.2L4.4 7H4v.6l8 5.4 8-5.4V7h-.4L12 12.2Z"/></svg>
          {local.email}
        </a>}
      </p>
    </div>
  </div>
  <div class="sh__wide sh__main">
    <a class="sh__brand" href="/">
      <img src="/logo-blanco.svg" alt={site.name} width="154" height="57" />
    </a>
    <details class="sh__menu">
      <summary><span class="sh__burger" aria-hidden="true"></span><span class="visually-hidden">Menú</span></summary>
      <nav aria-label="Principal">
        <ul>
          {site.nav.map((n) => (
            <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
          <li class="sh__menu-res"><a href="/contacto/#reservas">Reservar mesa</a></li>
        </ul>
      </nav>
    </details>
    <a class="sh__res" href="/contacto/#reservas">Reservar mesa</a>
  </div>
</header>
<style>
  .sh { position: relative; z-index: 50; background: var(--c-bg); border-bottom: 1px solid var(--c-line); }
  .sh--overlay { position: absolute; inset: 0 0 auto; background: linear-gradient(rgb(0 0 0 / 0.55), transparent); border-bottom: 0; }
  .sh__wide { width: min(100% - 2 * var(--space), 75rem); margin-inline: auto; }
  .sh__top { border-bottom: 1px solid var(--c-line); font-size: 0.8125rem; display: none; }
  .sh__top-in { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.85rem; }
  .sh__info { margin: 0; display: flex; align-items: center; gap: 0.5rem; }
  .sh__contact { gap: 1.75rem; }
  .sh__info a { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; }
  .sh__main { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 5.5rem; }
  .sh__brand img { width: 120px; height: auto; }
  .sh__menu summary { list-style: none; cursor: pointer; display: grid; place-items: center; width: 48px; height: 48px; }
  .sh__menu summary::-webkit-details-marker { display: none; }
  .sh__burger, .sh__burger::before, .sh__burger::after { display: block; width: 24px; height: 2px; background: #fff; position: relative; }
  .sh__burger::before, .sh__burger::after { content: ''; position: absolute; left: 0; }
  .sh__burger::before { top: -7px; } .sh__burger::after { top: 7px; }
  .sh__menu ul { list-style: none; margin: 0; padding: 0; }
  .sh__menu a {
    display: block; padding: 0.85rem 0; text-decoration: none;
    font: 500 0.75rem/1.2 var(--f-body); letter-spacing: 0.1em; text-transform: uppercase;
  }
  .sh__menu a[aria-current='page'] { color: var(--c-accent); }
  .sh__menu nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--c-bg); border-bottom: 1px solid var(--c-line); padding: 0.5rem var(--space) 1rem; }
  .sh__res { display: none; }
  @media (min-width: 64rem) {
    .sh__top { display: block; }
    .sh__main { min-height: 6.25rem; }
    .sh__brand { flex: 0 0 20%; }
    .sh__brand img { width: 154px; }
    .sh__menu { flex: 1; }
    .sh__menu summary { display: none; }
    .sh__menu nav { position: static; padding: 0; border: 0; background: none; }
    .sh__menu ul { display: flex; justify-content: center; gap: 2rem; }
    .sh__menu-res { display: none; }
    .sh__menu a { padding: 0.5rem 0; }
    .sh__menu a[aria-current='page'] { color: #fff; text-decoration: underline; text-underline-offset: 0.6em; text-decoration-thickness: 1px; }
    .sh__menu a:hover { color: var(--c-accent); }
    .sh__res {
      flex: 0 0 auto; margin-left: auto; display: inline-flex; align-items: center; min-height: 40px; padding: 0 1.4rem;
      border: 1px solid #fff; text-decoration: none; font: 600 0.75rem/1 var(--f-body); letter-spacing: 0.1em; text-transform: uppercase;
    }
    .sh__res:hover { background: #fff; color: #000; }
  }
</style>
<script is:inline>
  // En escritorio el menú está siempre abierto; en móvil se pliega. Sin JS sigue siendo un desplegable.
  (function () {
    var d = document.querySelector('.sh__menu');
    var mq = matchMedia('(min-width: 64rem)');
    function sync() { if (d) d.open = mq.matches; }
    sync(); mq.addEventListener('change', sync);
  })();
</script>
