---
// Pie de la web original: fila única con el menú en el centro y el copyright a la derecha.
// A la izquierda van los enlaces legales, que la web original no tenía.
import { site } from '../data/index.ts';
const year = new Date().getFullYear();
---
<footer class="sf">
  <div class="sf__in">
    <ul class="sf__legal">
      <li><a href="/aviso-legal/">Aviso legal</a></li>
      <li><a href="/politica-de-privacidad/">Privacidad</a></li>
      <li><a href="/politica-de-cookies/">Cookies</a></li>
    </ul>
    <nav aria-label="Pie de página">
      <ul class="sf__nav">
        {site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <p class="sf__copy">© {site.name} {year}{site.credit && <> | {site.credit}</>}</p>
  </div>
</footer>
<style>
  .sf { background: var(--c-footer-bg); border-top: 1px solid rgb(255 255 255 / 0.11); padding-block: 3.125rem; font-size: 0.9375rem; }
  .sf__in { width: min(100% - 2 * var(--space), 75rem); margin-inline: auto; display: grid; gap: 1.25rem; justify-items: center; text-align: center; }
  .sf ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem 1.75rem; }
  .sf a { text-decoration: none; display: inline-block; padding-block: 0.25rem; }
  .sf a:hover { color: var(--c-accent); }
  .sf__legal { font-size: 0.8125rem; color: var(--c-muted); }
  .sf__copy { margin: 0; }
  @media (min-width: 64rem) {
    .sf__in { grid-template-columns: 1fr auto 1fr; align-items: center; }
    .sf__legal { justify-self: start; }
    .sf__copy { justify-self: end; text-align: right; max-width: 16rem; }
  }
</style>
