---
// Pie de la web original: menú centrado y crédito a la derecha. Se añaden los enlaces legales.
import type { SiteData } from '@rea/core/lib/schema.ts';
interface Props { site: SiteData }
const { site } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap ftr__in">
    <nav aria-label="Pie de página">
      <ul>{site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <p>© {site.name} {year}{site.credit && <> | {site.credit}</>}</p>
  </div>
  <div class="wrap ftr__legal">
    <ul>
      <li><a href="/aviso-legal/">Aviso legal</a></li>
      <li><a href="/politica-de-privacidad/">Privacidad</a></li>
      <li><a href="/politica-de-cookies/">Cookies</a></li>
    </ul>
  </div>
</footer>
<style>
  .ftr { background: var(--c-footer-bg); color: var(--c-footer-text); border-top: 1px solid var(--c-line); padding-block: 2.25rem 1.5rem; font: 400 0.8rem/1.5 var(--f-body); }
  .ftr ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem 1.75rem; list-style: none; margin: 0; padding: 0; }
  .ftr a { text-decoration: none; display: inline-block; padding-block: 0.4rem; }
  .ftr a:hover { color: var(--c-accent); }
  .ftr__in { display: grid; gap: 1rem; justify-items: center; text-align: center; }
  .ftr__in p { margin: 0; }
  @media (min-width: 62rem) {
    .ftr__in { grid-template-columns: 1fr auto 1fr; }
    .ftr__in nav { grid-column: 2; }
    .ftr__in p { justify-self: end; text-align: right; max-width: 16rem; }
  }
  .ftr__legal { margin-top: 1rem; color: var(--c-muted); font-size: 0.75rem; }
</style>
