---
// La carta del núcleo (MenuSections) con los textos fijos en el idioma de la página:
// índice de secciones, alérgenos y pie. En español sale igual que la del núcleo.
import type { MenuData, MenuItemData } from '@rea/core/lib/schema.ts';
import { ALLERGENS } from '@rea/core/lib/schema.ts';
import { price } from '@rea/core/lib/format.ts';
import { T, ALLERGEN_NAMES, type Lang } from '../data/cartas.ts';
interface Props { menu: MenuData; lang?: Lang; headingLevel?: 2 | 3; hideZeroDecimals?: boolean; toc?: boolean }
const { menu, lang = 'es', headingLevel = 2, hideZeroDecimals = false, toc = true } = Astro.props;
const t = T[lang];
const allergen = (a: keyof typeof ALLERGENS) => (lang === 'es' ? ALLERGENS[a] : ALLERGEN_NAMES[lang][a] ?? ALLERGENS[a]);
const H = `h${headingLevel}` as 'h2' | 'h3';
const Hsub = `h${headingLevel + 1}` as 'h3' | 'h4';
const hasAllergens = menu.sections.some((s) => s.items.some((i) => i.allergens?.length));
const updated = new Date(menu.updated + 'T12:00:00').toLocaleDateString(t.locale, { month: 'long', year: 'numeric' });
const fmt = (v: number, unit: string, label?: string) => price(v, unit, { hideZeroDecimals }) + (label ? ` ${label}` : '');
const mainSections = menu.sections.filter((s) => !s.sub);
---
<div class="menu">
  {toc && mainSections.length > 2 && (
    <nav class="menu__toc" aria-label={t.toc}>
      <ul>{mainSections.map((s) => <li><a href={`#${s.id}`}>{s.name}</a></li>)}</ul>
    </nav>
  )}
  {menu.sections.map((s) => {
    const Tag = s.sub ? Hsub : H;
    // Plato vacío y oculto: el modo edición lo copia para dibujar los platos ocultos de este grupo.
    const items: Array<MenuItemData & { tpl?: boolean }> = [...s.items, ...(s.emId ? [{ name: '', unit: 'racion', price: 0, featured: false, suggestion: false, tpl: true } as MenuItemData & { tpl: boolean }] : [])];
    return (
      <section class:list={['menu__sec', { 'menu__sec--sub': s.sub }]} id={s.id} aria-labelledby={`${s.id}-h`}
        data-em-id={s.emId} data-em-type="menu-group">
        <Tag id={`${s.id}-h`} class="menu__h"><span data-em-field="name">{s.name}</span></Tag>
        <p class="menu__note" data-em-field="description" data-em-optional data-em-placeholder="Añadir nota del grupo" hidden={!s.note}>{s.note}</p>
        {s.priceHeaders && <p class="menu__ph" aria-hidden="true">{s.priceHeaders.filter(Boolean).join(' · ')}</p>}
        <ul class="menu__list" data-em-list={s.emId}>
          {items.map((i) => {
            const p1 = i.price != null ? fmt(i.price, i.unit, i.priceLabel) : null;
            const p2 = i.price2 != null ? fmt(i.price2, 'racion', i.price2Label) : null;
            return (
              <li class="menu__item" data-em-id={i.emId} data-em-type="dish" hidden={i.tpl} data-em-tpl={i.tpl ? '' : undefined}>
                <div class="menu__row">
                  <span class="menu__name" data-em-field="name">{i.name}</span>
                  {(p1 || p2) && <span class="menu__dots" aria-hidden="true"></span>}
                  {(p1 || p2) && (
                    <span class="menu__price">
                      {p1 && <span>{s.priceHeaders?.[0] && <span class="visually-hidden">{s.priceHeaders[0]}: </span>}<span data-em-field="price_1">{p1}</span></span>}
                      {p2 && <span class="menu__price2">{s.priceHeaders?.[1] && <span class="visually-hidden">{s.priceHeaders[1]}: </span>}<span data-em-field="price_2">{p2}</span></span>}
                    </span>
                  )}
                </div>
                <p class="menu__desc" data-em-field="description" data-em-optional data-em-placeholder="Añadir descripción" hidden={!i.description}>{i.description}</p>
                {i.allergens?.length ? (
                  <p class="menu__all"><span class="visually-hidden">{t.allergens}: </span>{i.allergens.map(allergen).join(' · ')}</p>
                ) : null}
              </li>
            );
          })}
        </ul>
      </section>
    );
  })}
  <footer class="menu__foot">
    {menu.notes.map((n) => <p>{n}</p>)}
    <p>{t.prices(updated)}</p>
    {!hasAllergens && <p>{t.askAllergens}</p>}
  </footer>
</div>
<style>
  .menu__toc { position: sticky; top: 4.25rem; z-index: 5; background: var(--c-bg); border-bottom: 1px solid var(--c-line); margin-bottom: 2rem; overflow-x: auto; }
  .menu__toc ul { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0.9rem 0; white-space: nowrap; }
  .menu__toc a { text-decoration: none; font-weight: 600; font-size: 0.95rem; }
  .menu__sec { padding-block: 2rem; scroll-margin-top: 8rem; }
  .menu__sec--sub { padding-top: 0.5rem; }
  .menu__h { font-size: clamp(1.6rem, 3.5vw, 2.25rem); border-bottom: 2px solid var(--c-text); padding-bottom: 0.5rem; margin-bottom: 1.25rem; }
  .menu__sec--sub .menu__h { font-size: 1.3rem; border-bottom-width: 1px; }
  .menu__note { color: var(--c-muted); font-style: italic; }
  .menu__ph { text-align: right; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--c-muted); margin: -0.5rem 0 0.75rem; }
  .menu__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  @media (min-width: 60rem) { .menu__list { grid-template-columns: 1fr 1fr; column-gap: 4rem; } }
  .menu__row { display: flex; align-items: baseline; gap: 0.6rem; }
  .menu__name { font-weight: 600; font-size: 1.05rem; }
  .menu__dots { flex: 1; border-bottom: 1px dotted var(--c-muted); min-width: 1.5rem; transform: translateY(-0.3em); }
  .menu__price { font-variant-numeric: tabular-nums; font-weight: 600; white-space: nowrap; display: inline-flex; flex-direction: column; align-items: flex-end; }
  .menu__price2 { font-weight: 400; color: var(--c-muted); font-size: 0.95em; }
  .menu__desc { color: var(--c-muted); font-size: 0.95rem; margin: 0.25rem 0 0; max-width: 34rem; }
  .menu__all { font-size: 0.8rem; color: var(--c-muted); margin: 0.2rem 0 0; }
  .menu__foot { margin-top: 2rem; color: var(--c-muted); font-size: 0.9rem; }
  .menu__foot p { margin: 0 0 0.4rem; }
</style>
